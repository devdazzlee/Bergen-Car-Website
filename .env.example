# Bergen API origin used by the Next.js server and client.
#
# Local development (next dev):
#   put this in .env.development.local
#   NEXT_PUBLIC_API_URL=http://localhost:4001
#
# VPS / production (next build + next start):
#   put this in .env.local (preferred) or .env.production
#   NEXT_PUBLIC_API_URL=https://bergen-api.187.77.19.146.sslip.io
#
# Do not put the local URL in .env.local if you also use that file for
# production builds on your laptop — Next loads .env.local in every mode.

NEXT_PUBLIC_API_URL=http://localhost:4001
