# Bergen API origin. Next.js picks the file by command — do not put the
# local URL in .env.local, because that file is also loaded during `next build`.
#
# next dev  → .env.development.local
NEXT_PUBLIC_API_URL=http://localhost:4001
#
# next build / production host env → .env.production
# NEXT_PUBLIC_API_URL=https://your-bergen-api.example.com
